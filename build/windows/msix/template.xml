<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="Lan Drop.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Lan-Drop\Lan Drop.exe">
    </Installer>
    <PackageInformation
        PackageName="Lan-Drop"
        PackageDisplayName="Lan Drop"
        PublisherName="CN=Lan Drop"
        PublisherDisplayName="Lan Drop"
        Version="0.1.0.0"
        PackageDescription="Share folders over your local network">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.landrop.app"
                Description="Share folders over your local network"
                DisplayName="Lan Drop"
                ExecutableName="Lan Drop.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Lan Drop</DisplayName>
            <PublisherDisplayName>Lan Drop</PublisherDisplayName>
            <Description>Share folders over your local network</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="Lan-Drop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
